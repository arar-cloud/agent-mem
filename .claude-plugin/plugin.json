{
  "name": "claude-mem",
  "version": "10.4.1",
  "description": "Persistent memory system for Claude Code - seamlessly preserve context across sessions",
  "author": {
    "name": "Alex Newman"
  },
  "repository": "https://github.com/thedotmack/claude-mem",
  "license": "AGPL-3.0",
  "keywords": [
    "memory",
    "context",
    "persistence",
    "hooks",
    "mcp"
  ],
  "backend": {
    "type": "python",
    "entry_point": "agent_mem.backend:main"
  },
  "capabilities": {
    "memory_compression": true,
    "context_persistence": true,
    "mcp_handler": true
  },
  "error_handling": {
    "strategy": "graceful_degradation",
    "context_compression_failure": "log_and_continue",
    "backend_initialization_failure": "fallback_to_memory"
  },
  "initialization": {
    "timeout_seconds": 5,
    "retry_attempts": 3,
    "error_recovery_enabled": true
  }
}
