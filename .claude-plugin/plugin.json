{
  "name": "claude-mem",
  "version": "10.5.6",
  "description": "Persistent memory system for Claude Code - seamlessly preserve context across sessions",
  "author": {
    "name": "Alex Newman"
  },
  "repository": "https://github.com/thedotmack/claude-mem",
  "license": "AGPL-3.0",
  "keywords": [
    "memory",
    "context",
    "persistence",
    "hooks",
    "mcp"
  ],
  "reliability": {
    "versionControl": {
      "expectedVersion": "10.5.6",
      "validateOnLoad": true,
      "mismatchAction": "fail-safe"
    },
    "initialization": {
      "retryPolicy": {
        "maxAttempts": 3,
        "backoffMultiplier": 2,
        "initialDelayMs": 100
      },
      "timeout": 30000,
      "fallbackMode": "memory-only"
    },
    "healthCheck": {
      "enabled": true,
      "interval": 60000,
      "endpoint": "/health"
    },
    "compression": {
      "transactions": {
        "enabled": true,
        "writeAheadLogging": true,
        "logDirectory": "./.claude-plugin/logs",
        "rollbackOnFailure": true
      }
    },
    "lifecycle": {
      "gracefulShutdown": true,
      "shutdownTimeout": 15000,
      "unloadHook": "onUnload",
      "cleanupHook": "onCleanup",
      "resourceCleanup": {
        "flushPendingWrites": true,
        "closeConnections": true,
        "cancelPendingTasks": true
      }
    },
    "retryPolicy": {
      "persistenceWrites": {
        "enabled": true,
        "maxAttempts": 5,
        "backoffStrategy": "exponential",
        "initialBackoffMs": 50,
        "maxBackoffMs": 10000,
        "backoffMultiplier": 2,
        "jitterEnabled": true
      }
    },
    "stateValidation": {
      "enabled": true,
      "checksumAlgorithm": "sha256",
      "validateOnSessionBoundary": true,
      "validateOnRestore": true,
      "corruptionRecovery": "fallback-to-cache",
      "persistChecksum": true,
      "checksumVerifyInterval": 5000
    }
  }
}
