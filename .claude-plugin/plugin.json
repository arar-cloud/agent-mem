{
  "name": "claude-mem",
  "version": "10.5.6",
  "description": "Persistent memory system for Claude Code - seamlessly preserve context across sessions",
  "author": {
    "name": "Alex Newman"
  },
  "repository": "https://github.com/thedotmack/claude-mem",
  "license": "AGPL-3.0",
  "keywords": [
    "memory",
    "context",
    "persistence",
    "hooks",
    "mcp"
  ],
  "reliability": {
    "initialization": {
      "retryPolicy": {
        "maxAttempts": 3,
        "backoffMultiplier": 2,
        "initialDelayMs": 100
      },
      "timeout": 30000,
      "fallbackMode": "memory-only"
    },
    "healthCheck": {
      "enabled": true,
      "interval": 60000,
      "endpoint": "/health"
    }
  }
}
