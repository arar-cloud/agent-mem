{
  "name": "thedotmack",
  "owner": {
    "name": "Alex Newman"
  },
  "metadata": {
    "description": "Plugins by Alex Newman (thedotmack)",
    "homepage": "https://github.com/thedotmack/claude-mem"
  },
  "plugins": [
    {
      "name": "claude-mem",
      "version": "10.5.6",
      "source": "./plugin",
      "description": "Persistent memory system for Claude Code - context compression across sessions",
      "stateValidation": {
        "enabled": true,
        "checksumAlgorithm": "sha256",
        "validateOnSessionBoundary": true,
        "corruptionRecovery": "fallback-to-cache"
      },
      "concurrency": {
        "lockingEnabled": true,
        "lockType": "distributed-mutex",
        "serializationMode": "fifo",
        "maxConcurrentWriters": 1,
        "deadlockDetection": true
      }
    }
  ]
}
